---
import { data, contentHash, profileId } from '../lib/content.mjs';
import { socialImagePath, socialSize } from '../lib/social.mjs';
import { fontAssets, fontCss } from '../lib/fonts.mjs';
import '../styles/global.css';
import '../styles/print.css';
import printStyles from '../styles/print.css?inline';
import Chevron from '../components/Chevron.astro';
const {
  lang = 'en',
  print = false,
  languageGateway = false,
  title = data.profile.name[lang],
} = Astro.props;
const previewStyles = printStyles.replaceAll('@media print', '@media screen');
const u = Object.fromEntries(Object.entries(data.ui).map(([k, v]) => [k, v[lang]]));
const other = lang === 'ko' ? 'en' : 'ko';
const tail = Astro.url.pathname.replace(/^\/(ko|en)/, '');
const pageTitle = `${title} · ${data.profile.role[lang]}`;
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const socialImage = new URL(socialImagePath(lang), Astro.site).href;
const socialAlt = `${data.profile.name[lang]} · ${data.profile.role[lang]} · ${data.hero.eyebrow[lang]}`;
---

<!doctype html>
<html lang={lang} data-page={print ? 'resume' : 'profile'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <slot name="head" />
    <style is:inline set:html={fontCss} />
    {fontAssets
      .filter((font) => lang === 'ko' || font.family === 'Inter' || font.weight === 600)
      .map((font) => (
        <link rel="preload" as="font" href={font.url} type="font/woff2" crossorigin="anonymous" />
      ))}
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#ffffff" />
    <meta name="description" content={data.hero.summary[lang]} />
    <meta name="content-hash" content={contentHash} />
    <meta name="resume-profile" content={profileId} />
    <meta name="robots" content={print ? 'noindex,follow' : 'index,follow'} />
    <title>{pageTitle}</title>
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={data.hero.summary[lang]} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:site_name" content="Jaeyong Lee" />
    <meta property="og:locale" content={lang === 'ko' ? 'ko_KR' : 'en_US'} />
    <meta property="og:locale:alternate" content={lang === 'ko' ? 'en_US' : 'ko_KR'} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content={socialSize.width} />
    <meta property="og:image:height" content={socialSize.height} />
    <meta property="og:image:alt" content={socialAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={data.hero.summary[lang]} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={socialAlt} />
    <link rel="canonical" href={`https://jaeyonge.github.io${Astro.url.pathname}`} />
    <link rel="alternate" hreflang={other} href={`https://jaeyonge.github.io/${other}${tail}`} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      try {
        const t = localStorage.getItem('resume-theme');
        if (['light', 'dark'].includes(t)) document.documentElement.dataset.theme = t;
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">
      {u.skip}
    </a>
    {!languageGateway && (
      <header class="site-header">
        <nav aria-label={u.menu}>
          <a class="wordmark" href={`/${lang}/`}>
            Jaeyong Lee
            <span class="wordmark-dot" aria-hidden="true">
              .
            </span>
          </a>
          <div class="nav-links">
            {['experience', 'research', 'education'].map((id, i) => (
              <a href={`/${lang}/#${id}`}>{u.section[i + 1]}</a>
            ))}
          </div>
          <details class="mobile-sections" data-header-menu>
            <summary aria-label={u.menu}>
              {u.sectionMenu}
              <Chevron />
            </summary>
            <div class="header-popover">
              {['about', 'experience', 'research', 'education', 'awards'].map((id, i) => (
                <a href={`/${lang}/#${id}`}>{u.section[i]}</a>
              ))}
            </div>
          </details>
          <div class="header-controls">
            <label class="sr-only" for="theme">
              {u.theme}
            </label>
            <select id="theme" name="theme" aria-label={u.theme}>
              <option value="system">{u.system}</option>
              <option value="light">{u.light}</option>
              <option value="dark">{u.dark}</option>
            </select>
            <details class="theme-picker" data-header-menu hidden>
              <summary aria-label={u.theme}>
                <svg
                  class="theme-compact-icon"
                  width="14"
                  height="14"
                  viewBox="0 0 16 16"
                  aria-hidden="true"
                >
                  <circle cx="8" cy="8" r="5.5" fill="none" stroke="currentColor" stroke-width="1.5" />
                  <path d="M8 2.5a5.5 5.5 0 0 0 0 11Z" fill="currentColor" />
                </svg>
                <span data-theme-label>{u.system}</span>
                <Chevron />
              </summary>
              <div class="header-popover theme-options" role="group" aria-label={u.theme}>
                {['system', 'light', 'dark'].map((value) => (
                  <button type="button" data-theme-choice={value} aria-pressed="false">
                    <span>{u[value]}</span>
                    <svg
                      class="choice-check"
                      width="14"
                      height="14"
                      viewBox="0 0 16 16"
                      fill="none"
                      aria-hidden="true"
                    >
                      <path
                        d="m3 8 3 3 7-7"
                        stroke="currentColor"
                        stroke-width="1.75"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>
                  </button>
                ))}
              </div>
            </details>
            <a
              class="language-switch"
              href={`/${other}${tail}`}
              hreflang={other}
              lang={other}
              data-language={other}
              aria-label={u.language}
            >
              {other === 'ko' ? '한국어' : 'EN'}
            </a>
          </div>
        </nav>
      </header>
    )}
    {print && (
      <aside class="print-toolbar">
        <a class="text-link" href={`/${lang}/`}>
          ← {u.back}
        </a>
        <button class="button primary" data-print>
          {u.print}
        </button>
        <a
          class="button secondary"
          data-download
          href={`/downloads/jaeyong-lee-resume-${lang}.pdf`}
          download
        >
          {u.download}
        </a>
      </aside>
    )}
    <main id="main" class:list={['page', print && 'resume-page']}>
      <slot />
    </main>
    {print && <style is:inline set:html={previewStyles} />}
    {print && <style is:inline>
      @media screen {
        html[data-page='resume'] body {
          background: #e9e9ec;
        }
        html[data-page='resume'] .print-toolbar {
          display: flex !important;
          width: calc(100% - 32px);
          max-width: 210mm;
          margin: 20px auto;
          padding: 0;
          gap: 12px;
          font:
            14px/1.5 Inter,
            sans-serif;
        }
        html[data-page='resume'] .print-toolbar .button {
          font: inherit;
          padding: 8px 14px;
          min-height: 40px;
          border: 1px solid #aaa;
          border-radius: 5px;
          background: #fff;
        }
        html[data-page='resume'] .resume-page {
          width: calc(100% - 32px);
          max-width: 210mm;
          margin: 0 auto 32px !important;
          padding: 8.5mm 11mm;
          background: #fff;
          box-shadow: 0 2px 14px #0002;
        }
        @media (max-width: 600px) {
          html[data-page='resume'] .resume-page {
            padding: 20px 16px;
          }
          html[data-page='resume'] .print-toolbar {
            flex-wrap: wrap;
          }
          html[data-page='resume'] .entry-position,
          html[data-page='resume'] .print-research-meta,
          html[data-page='resume'] .education-entry {
            display: block;
          }
          html[data-page='resume'] .entry-date {
            text-align: left;
            white-space: normal;
          }
          html[data-page='resume'] .print-links {
            display: flex;
            flex-wrap: wrap;
          }
          html[data-page='resume'] .print-identity > p:last-of-type {
            display: block;
          }
        }
      }
    </style>}
    {!languageGateway && (
      <footer class="site-footer">
        <div>
          <a href={`mailto:${data.profile.email}`}>{data.profile.email}</a>
          <span>{data.profile.location[lang]}</span>
          <span>
            {u.updated} {data.updated}
          </span>
        </div>
        <div class="footer-links">
          {data.profile.links.map((l) => (
            <a href={l.url}>{l.label} ↗</a>
          ))}
        </div>
      </footer>
    )}
    <script>
      const theme = document.querySelector<HTMLSelectElement>('#theme');
      if (theme) {
        const picker = document.querySelector<HTMLDetailsElement>('.theme-picker');
        const choices = [...document.querySelectorAll<HTMLButtonElement>('[data-theme-choice]')];
        const syncThemeControl = () => {
          const label = theme.selectedOptions[0].textContent;
          const current = picker?.querySelector('[data-theme-label]');
          if (current) current.textContent = label;
          choices.forEach((button) =>
            button.setAttribute('aria-pressed', String(button.dataset.themeChoice === theme.value)),
          );
        };
        theme.value = document.documentElement.dataset.theme || 'system';
        syncThemeControl();
        theme.addEventListener('change', () => {
          const value = theme.value;
          if (value === 'system') delete document.documentElement.dataset.theme;
          else document.documentElement.dataset.theme = value;
          try {
            localStorage.setItem('resume-theme', value);
          } catch {}
          syncThemeControl();
        });
        choices.forEach((button) =>
          button.addEventListener('click', () => {
            theme.value = button.dataset.themeChoice!;
            theme.dispatchEvent(new Event('change'));
            if (picker) picker.open = false;
            picker?.querySelector('summary')?.focus();
          }),
        );
        if (picker) {
          picker.hidden = false;
          theme.hidden = true;
        }
      }
      const menus = [...document.querySelectorAll<HTMLDetailsElement>('[data-header-menu]')];
      menus.forEach((menu) => {
        // WebKit does not focus buttons on pointer activation by default. Move
        // focus inside the menu before summary blur can close it and cancel click.
        menu.addEventListener('mousedown', (event) => {
          const button = (event.target as Element).closest('button');
          if (button && menu.contains(button)) {
            event.preventDefault();
            button.focus({ preventScroll: true });
          }
        });
        menu.addEventListener('toggle', () => {
          if (menu.open)
            menus.forEach((other) => {
              if (other !== menu) other.open = false;
            });
        });
        menu.addEventListener('keydown', (event) => {
          if (event.key === 'Escape') {
            menu.open = false;
            menu.querySelector('summary')?.focus();
          }
          if (!menu.open || !['ArrowDown', 'ArrowUp', 'Home', 'End'].includes(event.key)) return;
          const items = [...menu.querySelectorAll<HTMLButtonElement | HTMLAnchorElement>('button, a')];
          const index = items.indexOf(document.activeElement as HTMLButtonElement);
          const target =
            event.key === 'Home'
              ? 0
              : event.key === 'End'
                ? items.length - 1
                : index < 0
                  ? event.key === 'ArrowDown'
                    ? 0
                    : items.length - 1
                  : (index + (event.key === 'ArrowDown' ? 1 : -1) + items.length) % items.length;
          event.preventDefault();
          items[target]?.focus();
        });
        menu.addEventListener('focusout', (event) => {
          if (!menu.contains(event.relatedTarget as Node)) menu.open = false;
        });
      });
      document.addEventListener('click', (event) =>
        menus.forEach((menu) => {
          if (!menu.contains(event.target as Node)) menu.open = false;
        }),
      );
      document.querySelectorAll<HTMLAnchorElement>('[data-language]').forEach((link) =>
        link.addEventListener('click', () => {
          try {
            localStorage.setItem('resume-language', link.dataset.language!);
          } catch {}
        }),
      );
      document
        .querySelectorAll('.mobile-sections a')
        .forEach((link) =>
          link.addEventListener('click', () => link.closest('details')?.removeAttribute('open')),
        );
      document.querySelector('[data-print]')?.addEventListener('click', () => window.print());
    </script>
  </body>
</html>
