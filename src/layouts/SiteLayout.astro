---
import { data, contentHash, profileId } from '../lib/content.mjs';
import { socialImagePath, socialSize } from '../lib/social.mjs';
import { fontAssets, fontCss } from '../lib/fonts.mjs';
import '../styles/global.css';
import '../styles/print.css';
const {
  lang = 'en',
  print = false,
  languageGateway = false,
  title = data.profile.name[lang],
} = Astro.props;
const u = Object.fromEntries(Object.entries(data.ui).map(([k, v]) => [k, v[lang]]));
const other = lang === 'ko' ? 'en' : 'ko';
const tail = Astro.url.pathname.replace(/^\/(ko|en)/, '');
const pageTitle = `${title} · ${data.profile.role[lang]}`;
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const socialImage = new URL(socialImagePath(lang), Astro.site).href;
const socialAlt = `${data.profile.name[lang]} · ${data.profile.role[lang]} · ${data.hero.eyebrow[lang]}`;
---

<!doctype html>
<html lang={lang} data-page={print ? 'resume' : 'profile'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <slot name="head" />
    <style is:inline set:html={fontCss} />
    {fontAssets
      .filter((font) => lang === 'ko' || font.family === 'Inter' || font.weight === 600)
      .map((font) => (
        <link rel="preload" as="font" href={font.url} type="font/woff2" crossorigin="anonymous" />
      ))}
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#ffffff" />
    <meta name="description" content={data.hero.summary[lang]} />
    <meta name="content-hash" content={contentHash} />
    <meta name="resume-profile" content={profileId} />
    <meta name="robots" content={print ? 'noindex,follow' : 'index,follow'} />
    <title>{pageTitle}</title>
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={data.hero.summary[lang]} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:site_name" content="Jaeyong Lee" />
    <meta property="og:locale" content={lang === 'ko' ? 'ko_KR' : 'en_US'} />
    <meta property="og:locale:alternate" content={lang === 'ko' ? 'en_US' : 'ko_KR'} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content={socialSize.width} />
    <meta property="og:image:height" content={socialSize.height} />
    <meta property="og:image:alt" content={socialAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={data.hero.summary[lang]} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={socialAlt} />
    <link rel="canonical" href={`https://jaeyonge.github.io${Astro.url.pathname}`} />
    <link rel="alternate" hreflang={other} href={`https://jaeyonge.github.io/${other}${tail}`} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      try {
        const t = localStorage.getItem('resume-theme');
        if (['light', 'dark'].includes(t)) document.documentElement.dataset.theme = t;
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">
      {u.skip}
    </a>
    {!languageGateway && (
      <header class="site-header">
        <nav aria-label={u.menu}>
          <a class="wordmark" href={`/${lang}/`}>
            Jaeyong Lee
            <span class="wordmark-dot" aria-hidden="true">
              .
            </span>
          </a>
          <div class="nav-links">
            {['experience', 'research', 'education'].map((id, i) => (
              <a href={`/${lang}/#${id}`}>{u.section[i + 1]}</a>
            ))}
          </div>
          <div class="header-controls">
            <label class="sr-only" for="theme">
              {u.theme}
            </label>
            <select id="theme" name="theme" aria-label={u.theme}>
              <option value="system">{u.system}</option>
              <option value="light">{u.light}</option>
              <option value="dark">{u.dark}</option>
            </select>
            <a
              class="language-switch"
              href={`/${other}${tail}`}
              hreflang={other}
              lang={other}
              data-language={other}
              aria-label={u.language}
            >
              {other === 'ko' ? '한국어' : 'EN'}
            </a>
          </div>
        </nav>
      </header>
    )}
    {print && (
      <aside class="print-toolbar">
        <a class="text-link" href={`/${lang}/`}>
          ← {u.back}
        </a>
        <button class="button primary" data-print>
          {u.print}
        </button>
        <a
          class="button secondary"
          data-download
          href={`/downloads/jaeyong-lee-resume-${lang}.pdf`}
          download
        >
          {u.download}
        </a>
      </aside>
    )}
    <main id="main" class:list={['page', print && 'resume-page']}>
      <slot />
    </main>
    {!languageGateway && (
      <footer class="site-footer">
        <p>{u.footer}</p>
        <div>
          <a href={`mailto:${data.profile.email}`}>{data.profile.email}</a>
          <span>{data.profile.location[lang]}</span>
          <span>
            {u.updated} {data.updated}
          </span>
        </div>
        <div class="footer-links">
          {data.profile.links.map((l) => (
            <a href={l.url}>{l.label} ↗</a>
          ))}
          {!print && <a href={`/${lang}/compose/`}>{u.selectTitle} ↗</a>}
        </div>
      </footer>
    )}
    <script>
      const theme = document.querySelector<HTMLSelectElement>('#theme');
      if (theme) {
        theme.value = document.documentElement.dataset.theme || 'system';
        theme.addEventListener('change', () => {
          const value = theme.value;
          if (value === 'system') delete document.documentElement.dataset.theme;
          else document.documentElement.dataset.theme = value;
          try {
            localStorage.setItem('resume-theme', value);
          } catch {}
        });
      }
      document.querySelectorAll<HTMLAnchorElement>('[data-language]').forEach((link) =>
        link.addEventListener('click', () => {
          try {
            localStorage.setItem('resume-language', link.dataset.language!);
          } catch {}
        }),
      );
      document.querySelector('[data-print]')?.addEventListener('click', () => window.print());
    </script>
  </body>
</html>
