---
import registry from '../../content/logos.json';
const { id } = Astro.props;
const logo = registry[id];
if (!logo) throw new Error(`Missing logo ${id}`);
const themed = logo.light !== logo.dark;
---

<span class:list={['logo', logo.presentation]} aria-hidden="true" data-logo={id}>
  <img
    class:list={[themed && 'logo-light']}
    src={logo.light}
    alt=""
    width={logo.width}
    height={logo.height}
    loading="eager"
    decoding="sync"
  />
  {themed && (
    <img
      class="logo-dark"
      src={logo.dark}
      alt=""
      width={logo.width}
      height={logo.height}
      loading="eager"
      decoding="sync"
    />
  )}
</span>
